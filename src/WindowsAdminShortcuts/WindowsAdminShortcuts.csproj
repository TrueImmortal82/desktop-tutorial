<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowsAdminShortcuts</AssemblyName>
    <RootNamespace>WindowsAdminShortcuts</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.2.1</Version>
    <Authors>Vladislav Narechev</Authors>
    <Description>Manages desktop shortcuts, all-user wallpaper and a Win+P launcher.</Description>
    <RepositoryUrl>https://github.com/TrueImmortal82/desktop-tutorial</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WindowsAdminShortcuts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
