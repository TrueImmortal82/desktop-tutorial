<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowsAdminShortcuts</AssemblyName>
    <RootNamespace>WindowsAdminShortcuts</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsAdminShortcuts.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <InformationalVersion>2.3.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>True Immortal</Authors>
    <Description>Manages desktop shortcuts, all-user wallpaper and a Win+P launcher.</Description>
    <RepositoryUrl>https://github.com/TrueImmortal82/desktop-tutorial</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WindowsAdminShortcuts.Tests</_Parameter1>
    </AssemblyAttribute>
    <EmbeddedResource Include="Assets\WindowsAdminShortcuts.ico"
                      LogicalName="WindowsAdminShortcuts.AppIcon.ico" />
    <EmbeddedResource Include="..\..\LICENSE.txt"
                      LogicalName="WindowsAdminShortcuts.LICENSE.txt" />
    <None Include="..\..\LICENSE.txt"
          Link="LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
